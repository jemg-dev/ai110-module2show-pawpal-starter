classDiagram
    class Owner {
        +int owner_id
        +String name
        +String username
        +String email
        +List~Pet~ pets
        +create_user()
        +delete_user()
        +add_pet(pet)
        +remove_pet(pet_id)
        +get_all_tasks() List~Task~
    }

    class Pet {
        +int pet_id
        +String name
        +String species
        +String breed
        +int age
        +List~String~ dietary_restrictions
        +List~String~ allergies
        +String notes
        +List~Task~ tasks
        +add_pet()
        +remove_pet()
        +edit_pet()
        +add_task(task)
        +remove_task(task_id)
    }

    class Task {
        +int task_id
        +String title
        +String description
        +int duration_minutes
        +String priority
        +String category
        +bool is_recurring
        +bool is_completed
        +Time start_time
        +Time end_time
        +create_task()
        +delete_task()
        +edit_task()
        +mark_complete()
    }

    class Scheduler {
        +int schedule_id
        +Date date
        +Time start_time
        +Time end_time
        +List~Task~ tasks
        +add_task_to_schedule(task, start_time)
        +remove_task_from_schedule(task_id)
        +has_conflict(start_time, duration) bool
        +get_daily_schedule() List~Task~
        +find_next_available_slot(duration) Time
    }

    Owner "1" --> "0..*" Pet : owns
    Pet "1" --> "0..*" Task : has
    Owner "1" --> "0..*" Scheduler : manages
    Scheduler "1" o-- "0..*" Task : schedules
